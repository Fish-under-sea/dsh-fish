    "@fish-under-sea/dsh-client-ui-git-graph-fish": "^0.5.0",
    "@fish-under-sea/dsh-client-ui-task-board-fish": "^0.5.0",
    "@fish-under-sea/dsh-git-sync": "^0.4.0",
    "@fish-under-sea/dsh-session-archive-fish": "^0.5.0",
    "@fish-under-sea/dsh-settings-nav-order": "^0.1.5",
    "@fish-under-sea/dsh-skill-lens-fish": "^0.1.1",
    "@fish-under-sea/dsh-ssh-fish": "^0.5.0",
    "@fish-under-sea/dsh-usage-fish": "^0.5.0",
    "@fish-under-sea/dsh-visual-companion": "^0.1.7",
    "@fish-under-sea/dsh-video-preview-fish": "^0.2.0",
    "dsh-agent-teams-fish": "^0.7.2",
    "dsh-better-reasoning-effort-fish": "^0.5.8",
    "dsh-our-free-model-fish": "^2.2.0"
