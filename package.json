{
  "name": "@fish-under-sea/dsh-fish",
  "version": "1.0.0",
  "description": "Fish DSH 插件聚合包：十个本仓库子包与独立 AgentTeams，共十一个 @fish-under-sea 成员，统一 1.0.0。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "icon": "./icon.png",
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.png",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fish-under-sea/dsh-approval-guide": "1.0.0",
    "@fish-under-sea/dsh-client-ui-git-graph-fish": "1.0.0",
    "@fish-under-sea/dsh-client-ui-task-board-fish": "1.0.0",
    "@fish-under-sea/dsh-git-sync": "1.0.0",
    "@fish-under-sea/dsh-session-archive-fish": "1.0.0",
    "@fish-under-sea/dsh-settings-nav-order": "1.0.0",
    "@fish-under-sea/dsh-skill-lens-fish": "1.0.0",
    "@fish-under-sea/dsh-ssh-fish": "1.0.0",
    "@fish-under-sea/dsh-usage-fish": "1.0.0",
    "@fish-under-sea/dsh-visual-companion": "1.0.0",
    "@fish-under-sea/dsh-agent-teams-fish": "1.0.0"
  },
  "devDependencies": {
    "lightningcss": "^1.32.0",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "bundle",
    "agent-teams",
    "visual-companion",
    "fish"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Fish-under-sea/dsh-fish.git"
  },
  "scripts": {
    "test:release": "node --test scripts/release-contract.test.mjs"
  }
}
