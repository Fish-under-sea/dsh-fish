  "icon": "./icon.png",
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.png",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fish-under-sea/dsh-approval-guide": "^0.2.2",
    "@fish-under-sea/dsh-client-ui-git-graph": "^0.4.6",
    "@fish-under-sea/dsh-client-ui-model-capabilities": "^0.4.6",
    "@fish-under-sea/dsh-client-ui-task-board": "^0.4.6",
    "@fish-under-sea/dsh-git-sync": "^0.4.0",
    "@fish-under-sea/dsh-session-archive": "^0.4.6",
    "@fish-under-sea/dsh-settings-nav-order": "^0.1.5",
    "@fish-under-sea/dsh-skill-lens-fish": "^0.1.0",
    "@fish-under-sea/dsh-ssh": "^0.4.6",
    "@fish-under-sea/dsh-usage": "^0.4.6",
    "@fish-under-sea/dsh-visual-companion": "^0.1.7",
    "dsh-agent-teams-fish": "^0.6.1",
    "dsh-better-reasoning-effort-fish": "^0.5.8",
    "dsh-our-free-model": "^2.1.0"
