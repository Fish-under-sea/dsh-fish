{
  "name": "@fish-under-sea/dsh-fish",
  "version": "0.6.7",
  "description": "Fish 自建 DSH 插件全家桶聚合包：一键插入本人自建插件与常用外部补充插件的插件行（approval-guide / session-title-refresh / git-sync / settings-nav-order + agent-teams / visual-companion / better-reasoning-effort）。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fish-under-sea/dsh-approval-guide": "^0.2.1",
    "@fish-under-sea/dsh-session-title-refresh": "^0.2.1",
    "@fish-under-sea/dsh-git-sync": "^0.2.7",
    "@fish-under-sea/dsh-settings-nav-order": "^0.1.4",
    "@fish-under-sea/dsh-visual-companion": "^0.1.5",
    "dsh-agent-teams-fish": "^0.3.2",
    "dsh-better-reasoning-effort-fish": "^0.5.5"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "bundle",
    "agent-teams",
    "visual-companion",
    "fish"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Fish-under-sea/dsh-fish.git"
  }
}