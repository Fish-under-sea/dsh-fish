{
  "name": "@fish-under-sea/dsh-settings-nav-order",
  "version": "1.0.2",
  "description": "DeepSeek Harness 设置导航与斜杠菜单顺序：重排、隐藏设置侧栏；为 agent-teams、companion、acp、acp-cache 补充图标和中文标题，支持自定义默认顺序。偏好随浏览器本地状态及 $DSH_HOME/dsh-settings-nav-order/state.json 持久化。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "settings",
    "nav",
    "order"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Fish-under-sea/dsh-fish.git",
    "directory": "packages/dsh-settings-nav-order"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test test/*.mjs"
  }
}
