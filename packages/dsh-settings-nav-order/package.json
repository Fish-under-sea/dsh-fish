{
  "name": "@fish-under-sea/dsh-settings-nav-order",
  "version": "0.1.4",
  "description": "DeepSeek Harness Web 设置导航顺序自定义：用「设置 → 设置导航顺序」里的上移/下移把左边这列菜单排成你要的样子，顺序存在浏览器 localStorage 并同步落盘到 $DSH_HOME/dsh-settings-nav-order/state.json（随 Git 同步插件跨机复原），不改任何第三方插件的代码。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "settings",
    "nav",
    "order"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Fish-under-sea/dsh-fish.git",
    "directory": "packages/dsh-settings-nav-order"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}