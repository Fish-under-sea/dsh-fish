{
  "name": "@fish-under-sea/dsh-better-reasoning-effort-fish",
  "version": "2.0.0",
  "description": "第三方模型的思考强度与输入模态设置（DeepSeek Harness 插件）：每个模型声明思考档位与图片输入，由内置模型知识库与线协议推断自动适配，直接在官方「模型」页卡片内编辑；自带八款模型家族奔跑角色主题。",
  "license": "MIT",
  "author": {
    "name": "Fish-under-sea",
    "url": "https://github.com/Fish-under-sea"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fish-under-sea/dsh-fish.git",
    "directory": "packages/dsh-better-reasoning-effort-fish"
  },
  "homepage": "https://github.com/Fish-under-sea/dsh-fish/tree/main/packages/dsh-better-reasoning-effort-fish#readme",
  "bugs": {
    "url": "https://github.com/Fish-under-sea/dsh-fish/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "reasoning-effort",
    "reasoning",
    "thinking",
    "input-modality",
    "modalities",
    "vision",
    "llm-settings",
    "fish"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "src/",
    "assets/",
    "locale/",
    "docs/*.svg",
    "docs/*.png",
    "cordis.patch.yml",
    "icon.png",
    "screenshots.json",
    "README.md",
    "README.en.md",
    "README.original.md",
    "README_ZH.original.md",
    "NOTICE.md",
    "FORK.md",
    "LICENSE"
  ],
  "icon": "./icon.png",
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build:clean && npm run build:host && npm run build:client && npm run build:types",
    "build:clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build:host": "node scripts/build-host.mjs",
    "build:client": "npm run check:styles && node scripts/build-client.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "check:styles": "node scripts/check-styles.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-remotes": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.19.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-api-remotes": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-model-selection": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0"
  }
}
