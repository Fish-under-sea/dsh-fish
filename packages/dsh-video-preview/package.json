{
  "name": "@fish-under-sea/dsh-video-preview",
  "version": "0.1.5",
  "description": "Inline video preview for dsh-better-sidebar: plays .mp4/.webm/.mov/.mkv/.avi etc. in the sidebar editor with HTTP Range (seeking) support via a dedicated /video host route. Fish fork of zemul/dsh-video-preview: the removed `webRuntime` service is no longer a hard dependency, so the row actually activates on DSH >= 0.2.1-alpha.2.",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.original.md",
    "LICENSE",
    "NOTICE",
    "test"
  ],
  "exports": {
    ".": "./index.js",
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "better-sidebar",
    "video",
    "preview",
    "file-viewer"
  ],
  "license": "MIT",
  "author": "zemul <zemul@foxmail.com>",
  "homepage": "https://github.com/zemul/dsh-video-preview",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fish-under-sea/dsh-fish.git",
    "directory": "packages/dsh-video-preview"
  },
  "bugs": {
    "url": "https://github.com/zemul/dsh-video-preview/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
